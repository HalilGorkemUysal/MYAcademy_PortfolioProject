@model MYAcademy_PortfolioProject.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int total = Model.TotalMessageCount;
    int unread = Model.UnreadMessageCount;
    int read = Model.ReadMessageCount;

    int rate = total == 0 ? 0 : read * 100 / total;

    var labels = Model.WeeklyMessages
        .Select(x => x.Date.ToString("ddd", new System.Globalization.CultureInfo("tr-TR")))
        .ToArray();

    var counts = Model.WeeklyMessages
        .Select(x => x.MessageCount)
        .ToArray();

    int max = counts.Length == 0 ? 1 : Math.Max(counts.Max(), 1);
}

<style>
    .db {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .db-title small {
            color: var(--muted);
            font-weight: 400;
        }

    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .3rem;
    }

    .c-green {
        background: var(--g-soft);
        color: var(--g);
    }

    .c-blue {
        background: #e6eef8;
        color: #3b6ea5;
    }

    .c-rose {
        background: #f9e7e7;
        color: #b44b4b;
    }

    .bars {
        display: flex;
        align-items: flex-end;
        gap: .8rem;
        height: 190px;
    }

    .bar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        gap: .4rem;
    }

    .bar-fill {
        width: 100%;
        max-width: 42px;
        background: var(--g);
        border-radius: 8px 8px 4px 4px;
        opacity: .85;
        transition: opacity .2s;
    }

    .bar:hover .bar-fill {
        opacity: 1;
    }

    .bar span {
        font-size: .75rem;
        color: var(--muted);
    }

    .bar b {
        font-size: .8rem;
    }

    .donut {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        margin: .5rem auto 1.2rem;
        display: grid;
        place-items: center;
        background: conic-gradient(var(--g) calc(var(--p) * 1%), var(--g-soft) 0);
    }

        .donut div {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            font-size: 1.6rem;
            font-weight: 700;
        }

    .legend {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            margin-right: .35rem;
        }

    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .8rem 0;
        border-bottom: 1px solid var(--line);
    }

        .msg-row:last-child {
            border-bottom: none;
        }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

        .msg-body p {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .badge-soft {
        font-size: .72rem;
        padding: .3rem .6rem;
        border-radius: 20px;
    }
</style>

<div class="db container-fluid py-3">

    <!-- Dinamik istatistik kartları -->
    <div class="row g-4 mb-4">
        
        @{
            var stats = new[]
            {
        (Val: Model.TotalProjectCount.ToString(), Lbl: "Toplam Proje",
         Icon: "bi-folder", Cls: "c-green"),

        (Val: Model.ActiveProjectCount.ToString(), Lbl: "Aktif Proje",
         Icon: "bi-folder-check", Cls: "c-blue"),

        (Val: Model.SkillCount.ToString(), Lbl: "Yetenekler",
         Icon: "bi-stars", Cls: "c-green"),

        (Val: Model.ExperienceCount.ToString(), Lbl: "Deneyimler",
         Icon: "bi-briefcase", Cls: "c-blue"),

        (Val: Model.EducationCount?.ToString() ?? "—", Lbl: "Eğitim",
         Icon: "bi-mortarboard", Cls: "c-green"),

        (Val: Model.TotalMessageCount.ToString(), Lbl: "Toplam Mesaj",
         Icon: "bi-envelope", Cls: "c-blue"),

        (Val: Model.UnreadMessageCount.ToString(), Lbl: "Okunmamış Mesaj",
         Icon: "bi-envelope-exclamation", Cls: "c-rose")
    };
        }

        @foreach (var s in stats)
        {
            <div class="col-md-6 col-xl-3">
                <div class="db-card stat">
                    <div class="stat-icon @s.Cls">
                        <i class="bi @s.Icon"></i>
                    </div>
                    <div>
                        <div class="stat-val">@s.Val</div>
                        <div class="stat-lbl">@s.Lbl</div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="row g-4 mb-4">
        <!-- Haftalık grafik (statik) -->
        <div class="col-xl-8">
            <div class="db-card">
                <div class="db-title">Son 7 Gün <small>Günlük gelen mesajlar</small></div>
                <div class="bars">
                    @for (int i = 0; i < counts.Length; i++)
                    {
                        <div class="bar">
                            <b>@counts[i]</b>
                            <div class="bar-fill" style="height:@(counts[i] * 100 / max)%"></div>
                            <span>@labels[i]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Okunma oranı (v1 ve v3'ten hesaplanır) -->
        <div class="col-xl-4">
            <div class="db-card">
                <div class="db-title">Okunma Oranı</div>
                <div class="donut" style="--p:@rate"><div>%@rate</div></div>
                <div class="legend">
                    <span><i style="background:var(--g)"></i>Okundu (@read)</span>
                    <span><i style="background:var(--g-soft)"></i>Okunmadı (@unread)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Son mesajlar (statik) -->
    <!-- Son 5 Mesaj (Dinamik) -->
    <div class="db-card">
        <div class="db-title">
            Son 5 Mesaj

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="MessageList"
               class="small text-decoration-none"
               style="color:var(--g)">
                Tümünü gör →
            </a>
        </div>

        @foreach (var m in Model.LastMessages)
        {
            <div class="msg-row">

                <div class="avatar">
                    @(string.IsNullOrWhiteSpace(m.SenderName)
                        ? "?"
                        : m.SenderName.Substring(0, 1).ToUpper())
                </div>

                <div class="msg-body">
                    <strong>@m.SenderName</strong>
                    ·
                    <span class="small">@m.Subject</span>

                    <p>@m.MessageDetail</p>
                </div>

                <small class="text-muted d-none d-md-block">
                    @m.SendDate.ToString("dd.MM.yyyy HH:mm")
                </small>

                @if (m.IsRead)
                {
                    <span class="badge-soft c-blue">
                        Okundu
                    </span>
                }
                else
                {
                    <span class="badge-soft c-rose">
                        Okunmadı
                    </span>
                }

            </div>
        }

        @if (!Model.LastMessages.Any())
        {
            <p class="text-muted text-center py-3">
                Henüz mesaj bulunmuyor.
            </p>
        }
    </div>

    
    <div class="db-card mt-4">
        <div class="db-title">
            Kategori Özeti
        </div>

        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th>Proje Sayısı</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.CategorySummary)
                {
                    <tr>
                        <td>@item.CategoryName</td>
                        <td>
                            <span class="badge bg-success">
                                @item.ProjectCount
                            </span>
                        </td>
                    </tr>
                }

                @if (!Model.CategorySummary.Any())
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted">
                            Henüz kategori bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    
    <div class="db-card mt-4">
        <div class="db-title">
            Son Eklenen 3 Proje

            <a asp-area="Admin"
               asp-controller="Project"
               asp-action="ProjectList"
               class="small text-decoration-none"
               style="color:var(--g)">
                Tümünü gör →
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Proje Adı</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var project in Model.LastProjects)
                    {
                        <tr>
                            <td>@project.ProjectTitle</td>

                            <td>@project.Category?.CategoryName</td>

                            <td>
                                @if (project.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Pasif
                                    </span>
                                }
                            </td>
                        </tr>
                    }

                    @if (!Model.LastProjects.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                Henüz proje bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    
    <div class="db-card mt-4">
        <div class="db-title">
            Hızlı Erişim
        </div>

        <div class="d-flex flex-wrap gap-3">

            <a asp-area="Admin"
               asp-controller="Project"
               asp-action="CreateProject"
               class="btn btn-success">

                <i class="bi bi-plus-circle me-1"></i>
                Yeni Proje Ekle
            </a>

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="MessageList"
               class="btn btn-outline-success">

                <i class="bi bi-envelope me-1"></i>
                Mesajları Gör
            </a>

        </div>
    </div>


</div>