@model List<Skill>

@{
    ViewData["Title"] = "SkillList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Yetenek Başlığı</th>
                <th>Açıklama</th>
                <th>İkon URL</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SkillId</td>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>@item.IconUrl</td>
                    <td>
                        <a href="/Admin/Skill/DeleteSkill/@item.SkillId"
                           class="btn btn-danger">
                            Sil
                        </a>
                    </td>
                    <td>
                        <a href="/Admin/Skill/UpdateSkill/@item.SkillId"
                           class="btn btn-info">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="/Admin/Skill/CreateSkill/"
       class="btn btn-success">
        Yeni Yetenek Ekle
    </a>

</div>
