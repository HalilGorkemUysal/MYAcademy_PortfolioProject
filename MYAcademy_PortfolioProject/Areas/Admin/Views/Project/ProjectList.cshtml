@model List<Project>

@{
    ViewData["Title"] = "ProjectList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Proje Adı</th>
                <th>Kategori</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProjectId</td>
                    <td>@item.ProjectTitle</td>
                    <td>@item.Category.CategoryName</td>
                    <td><a class="btn btn-danger" href="/Admin/Project/DeleteProject/@item.ProjectId/">Sil</a></td>
                    <td><a class="btn btn-info" href="/Admin/Project/UpdateProject/@item.ProjectId/">Güncelle</a></td>
                </tr>
            }

        </tbody>
        
    </table>
    <a class="btn btn-success" href="/Admin/Project/CreateProject/">Ekle</a>

</div>