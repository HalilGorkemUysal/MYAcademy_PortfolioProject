@model List<Experience>
@{
    ViewData["Title"] = "ExperienceList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    string durum = "";
}

<main class="page-content-area">

    <!-- 4 Statistics Summary Cards -->
    <div class="stats-row">
        <!-- 1. Toplam Deneyim -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green">
                <i class="bi bi-briefcase"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Toplam Deneyim</span>
                <h3 class="stat-value" id="statTotalCount">@ViewBag.v1</h3>
            </div>
        </div>

        <!-- 2. Aktif Kayıt -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Aktif Kayıt</span>
                <h3 class="stat-value" id="statActiveCount">@ViewBag.v2</h3>
            </div>
        </div>

        <!-- 3. Pasif Kayıt -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Pasif Kayıt</span>
                <h3 class="stat-value" id="statPassiveCount">@ViewBag.v3</h3>
            </div>
        </div>

        <!-- 4. Son Güncelleme -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-purple">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Memnuniyet</span>
                <h3 class="stat-value" style="font-size: 1.05rem; font-weight: 700; line-height: 1.4;">10/10</h3>
            </div>
        </div>
    </div>

    <!-- Main Experience Table Container -->
    <div class="data-table-card">

        <!-- Experience Table -->
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table" id="experienceTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Deneyim Başlığı</th>
                        <th>Kurum / Şirket</th>
                        <th>Tarih Aralığı</th>
                        <th>Çalışma Alanı</th>
                        <th>Durum</th>
                        <th>Sil</th>
                        <th>Güncelle</th>
                    </tr>
                </thead>
                <tbody id="experienceTableBody">
                    @foreach (var item in Model)
                    {
                        if (item.IsActive)
                        {
                            durum = "Devam Ediyor";
                        }
                        else
                        {
                            durum = "Devam Etmiyor";
                        }
                        <tr data-id="1" data-status="Aktif" data-order="1">
                            <td class="col-id">@item.ExperienceId</td>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-laptop"></i>
                                    </div>
                                    <div>
                                        <span class="exp-title-text">@item.Title</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="company-cell">
                                    <i class="bi bi-building company-badge-icon"></i>
                                    <span>@item.CompanyName</span>
                                </div>
                            </td>
                            <td>
                                <span class="work-type-badge">@item.Description</span>
                            </td>
                            <td>
                                <span class="work-type-badge-purple">@item.CategoryName</span>
                            </td>
                            <td>
                                <span class="status-pill status-active">@durum</span>
                            </td>
                            <td>
                                <a class="btn btn-danger" href="/Admin/Experience/DeleteExperience/@item.ExperienceId">Sil</a>
                            </td>
                            <td>
                                <a class="btn btn-info" href="/Admin/Experience/UpdateExperience/@item.ExperienceId">Güncelle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer-area">
            <a class="btn btn-info" href="/Admin/Experience/CreateExperience/">Yeni Ekle</a>
        </div>
    </div>

</main>