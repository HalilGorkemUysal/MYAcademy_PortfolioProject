@model HeroSection

@{
    ViewData["Title"] = "UpdateHeroSection";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />

    <h4>Hero Alanı Güncelle</h4>
    <hr />

    <form method="post"
          action="/Admin/HeroSection/UpdateHeroSection"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="HeroSectionId" />

        <div class="mb-3">
            <label>Karşılama Yazısı</label>
            <input type="text"
                   asp-for="Greeting"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Başlık</label>
            <input type="text"
                   asp-for="Title"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Açıklama</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      required></textarea>
        </div>

        <div class="mb-3">
            <label>Mevcut Görsel</label>
            <br />

            @if (!string.IsNullOrEmpty(Model.MainImageUrl))
            {
                <img src="@Model.MainImageUrl"
                     width="150"
                     class="img-thumbnail mb-2" />
            }
        </div>

        <div class="mb-3">
            <label>Yeni Hero Görseli</label>
            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept="image/*" />

            <small class="text-muted">
                Yeni görsel seçmezseniz mevcut görsel korunur.
            </small>
        </div>

        <button type="submit" class="btn btn-success">
            Güncelle
        </button>

        <a href="/Admin/HeroSection/HeroSectionList"
           class="btn btn-secondary">
            Geri Dön
        </a>

    </form>
</div>
