@model Message

@{
    ViewData["Title"] = "UpdateMessage";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />
    <h4>Mesaj Durumunu Güncelle</h4>
    <hr />

    <form method="post"
          asp-area="Admin"
          asp-controller="Message"
          asp-action="UpdateMessage">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.MessageId" />

        <div class="mb-3">
            <label>Gönderen Ad Soyad</label>
            <input type="text"
                   class="form-control"
                   value="@Model.SenderName"
                   readonly />
        </div>

        <div class="mb-3">
            <label>Gönderen E-posta</label>
            <input type="text"
                   class="form-control"
                   value="@Model.SenderEmail"
                   readonly />
        </div>

        <div class="mb-3">
            <label>Mesaj Konusu</label>
            <input type="text"
                   class="form-control"
                   value="@Model.Subject"
                   readonly />
        </div>

        <div class="mb-3">
            <label>Mesaj İçeriği</label>
            <textarea class="form-control"
                      rows="5"
                      readonly>@Model.MessageDetail</textarea>
        </div>

        <div class="mb-3">
            <label>Gönderim Tarihi</label>
            <input type="text"
                   class="form-control"
                   value="@Model.SendDate.ToString("dd.MM.yyyy HH:mm")"
                   readonly />
        </div>

        <div class="mb-3">
            <label>Mesaj Durumu</label>

            <select name="isRead" class="form-control">
                <option value="false"
                        selected="@(!Model.IsRead)">
                    Okunmadı
                </option>

                <option value="true"
                        selected="@(Model.IsRead)">
                    Okundu
                </option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Durumu Güncelle
        </button>

        <a href="/Admin/Message/MessageList"
           class="btn btn-secondary">
            Geri Dön
        </a>
    </form>
</div>
