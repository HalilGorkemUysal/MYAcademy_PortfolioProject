@model Message

@{
    ViewData["Title"] = "CreateMessage";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />
    <h4>Yeni Mesaj Ekle</h4>
    <hr />

    <form method="post"
          asp-area="Admin"
          asp-controller="Message"
          asp-action="CreateMessage">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label>Gönderen Ad Soyad</label>
            <input type="text"
                   asp-for="SenderName"
                   class="form-control"
                   required />
            <span asp-validation-for="SenderName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Gönderen E-posta</label>
            <input type="email"
                   asp-for="SenderEmail"
                   class="form-control"
                   required />
            <span asp-validation-for="SenderEmail"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Mesaj Konusu</label>
            <input type="text"
                   asp-for="Subject"
                   class="form-control"
                   required />
            <span asp-validation-for="Subject"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Mesaj İçeriği</label>
            <textarea asp-for="MessageDetail"
                      class="form-control"
                      rows="5"
                      required></textarea>
            <span asp-validation-for="MessageDetail"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            Mesajı Kaydet
        </button>

        <a href="/Admin/Message/MessageList"
           class="btn btn-secondary">
            Geri Dön
        </a>
    </form>
</div>
