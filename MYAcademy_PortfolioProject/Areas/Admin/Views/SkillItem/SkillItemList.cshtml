@model List<SkillItem>

@{
    ViewData["Title"] = "SkillItemList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Yetenek Detayı</th>
                <th>Bağlı Olduğu Yetenek</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SkillItemId</td>
                    <td>@item.SkillItemTitle</td>
                    <td>@item.Skill.Title</td>
                    <td>
                        <a href="/Admin/SkillItem/DeleteSkillItem/@item.SkillItemId"
                           class="btn btn-danger">
                            Sil
                        </a>
                    </td>
                    <td>
                        <a href="/Admin/SkillItem/UpdateSkillItem/@item.SkillItemId"
                           class="btn btn-info">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="/Admin/SkillItem/CreateSkillItem/"
       class="btn btn-success">
        Yeni Yetenek Detayı Ekle
    </a>

</div>
