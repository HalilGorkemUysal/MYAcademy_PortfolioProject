@model About

@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />

    <h4>Yeni Hakkımda Ekle</h4>
    <hr />

    <form asp-area="Admin"
          asp-controller="About"
          asp-action="CreateAbout"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label>Başlık</label>
            <input type="text"
                   asp-for="Title"
                   class="form-control"
                   placeholder="Hakkımda başlığını giriniz"
                   required />
            <span asp-validation-for="Title"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Açıklama</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="6"
                      placeholder="Hakkımda açıklamasını giriniz"
                      required></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Yıl Deneyim</label>
            <input type="text"
                   asp-for="ExperienceCount"
                   class="form-control"
                   placeholder="Örn: 3+"
                   required />
            <span asp-validation-for="ExperienceCount"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Eğitim İçeriği Sayısı</label>
            <input type="text"
                   asp-for="EducationContentCount"
                   class="form-control"
                   placeholder="Örn: 25+"
                   required />
            <span asp-validation-for="EducationContentCount"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Öğrenci Sayısı</label>
            <input type="text"
                   asp-for="StudentCount"
                   class="form-control"
                   placeholder="Örn: 200K+"
                   required />
            <span asp-validation-for="StudentCount"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Profil Görseli</label>
            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp"
                   required />
            <span asp-validation-for="ImageUrl"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            Kaydet
        </button>

        <a href="/Admin/About/AboutList"
           class="btn btn-secondary">
            Geri Dön
        </a>
    </form>
</div>
