@model List<Contact>
@{
    ViewData["Title"] = "ContactList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<div class="container">
    <br />
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Başlık</th>
                <th>Açıklama</th>
                <th>Mail</th>
                <th>Konum</th>
                <th>Telefon</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ContactId</td>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>@item.Email</td>
                    <td>@item.Location</td>
                    <td>@item.PhoneNumber</td>
                    <td><a href="/Admin/Contact/DeleteContact/@item.ContactId" class="btn btn-info">Sil</a></td>
                    <td><a href="/Admin/Contact/UpdateContact/@item.ContactId" class="btn btn-info">Güncelle</a></td>
                </tr>
            }
        </tbody>

    </table>
</div>